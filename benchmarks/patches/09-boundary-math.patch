+// UPSTREAM-I: days since the epoch for a proleptic-gregorian date (Howard
+// Hinnant's days_from_civil; the same routine UPSTREAM-B keeps privately in
+// IANAZone.js). Exported for the weekday math in conversions.js. Hoisting
+// IANAZone's copy out to here would put churn in an unrelated patch, so the
+// two stand until a merge unifies them.
+export function daysFromCivil(y, m, d) {
+  y -= m <= 2 ? 1 : 0;
+  const era = Math.floor(y / 400);
+  const yoe = y - era * 400;
+  const doy = Math.floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5);
+  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy + d - 1;
+  return era * 146097 + doe - 719468;
+}
