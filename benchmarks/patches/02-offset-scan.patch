+// UPSTREAM-B: Howard Hinnant's paired civil-date conversions. Keeping both
+// directions here gives the offset scanner, DateTime field extraction, calendar
+// diffs and weekday math one proleptic-Gregorian implementation.
+export function daysFromCivil(y, m, d) {
+  y -= m <= 2 ? 1 : 0;
+  const era = Math.floor(y / 400);
+  const yoe = y - era * 400;
+  const doy = Math.floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5);
+  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy + d - 1;
+  return era * 146097 + doe - 719468;
+}
+
+export function civilDayDiff(a, b) {
+  return daysFromCivil(b.year, b.month, b.day) - daysFromCivil(a.year, a.month, a.day);
+}
+
+// Writes into an existing result so tsToObj keeps its single allocation.
+export function civilFromDays(days, result) {
+  const z = days + 719468;
+  const era = Math.floor(z / 146097);
+  const doe = z - era * 146097;
+  const yoe = Math.floor(
+    (doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365
+  );
+  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
+  const mp = Math.floor((5 * doy + 2) / 153);
+  const month = mp < 10 ? mp + 3 : mp - 9;
+
+  result.year = yoe + era * 400 + (month <= 2 ? 1 : 0);
+  result.month = month;
+  result.day = doy - Math.floor((153 * mp + 2) / 5) + 1;
+  return result;
+}
