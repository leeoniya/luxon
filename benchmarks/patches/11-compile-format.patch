+// ---- UPSTREAM-K: compiled format programs ----------------------------------
+// A format string compiles to alternating literal/handler runs. Handlers take
+// (formatter, dateTime, knownEnglish, useDateTimeFormatter) so that a program
+// depends on the pattern alone and can be shared across locales and formatters.
+
+const cfPrograms = new Map();
+const cfDurationPrograms = new Map();
+const CF_CACHE_MAX = 1000;
+
+const cfExtract = (f, dt, opts, field) => f.loc.extract(dt, opts, field);
+
+// Name tokens, memoized per locale.
+//
+// A name token — a month, a weekday, an era, a day period — has no fast path the
+// way a numeric one does. English reads a constant array; every other locale
+// calls loc.extract(), which is an Intl.DateTimeFormat.formatToParts() plus a
+// find() over its parts, once per token per value. "cccc, LLLL d, yyyy 'at'
+// h:mm a" in fr is three of those per value and ~20x the same pattern in en.
+//
+// Locale already caches these lists — monthsCache, weekdaysCache, meridiemCache
+// — but only Info.months and its neighbours read them; the formatter has always
+// gone straight to extract(). Which is how Info.months in fr costs ~1ms per 20k
+// while formatting a pattern that names a month costs ~150ms.
+//
+// Reading Locale's lists from here is the obvious fix and the wrong one: it does
+// not pass the Intl options the formatter passes — a format-context weekday
+// there carries year: "numeric", here it does not — and swapping them silently
+// changes what fi and fa render. So this memoizes the formatter's OWN extract
+// call, keyed by the field the answer depends on: same options, same call, same
+// string, once per distinct field value instead of once per value.
+const cfNames = new WeakMap();
+const cfCalendars = new WeakMap();
+
+function cfMemo(f, dt, opts, field, key, size, at) {
+  let per = cfNames.get(f.loc);
+
+  if (per === undefined) cfNames.set(f.loc, (per = new Map()));
+
+  let slots = per.get(key);
+
+  if (slots === undefined) per.set(key, (slots = new Array(size)));
+
+  const hit = slots[at];
+
+  return hit !== undefined ? hit : (slots[at] = f.loc.extract(dt, opts, field));
+}
+
+// Whether the calendar these names come out of is the one dt's fields are in. A
+// month name is a function of dt.month only when it is: "fa" resolves to the
+// persian calendar with no outputCalendar named, where the rendered month tracks
+// the Persian one and a slot keyed by the Gregorian month would hand back a
+// neighbour's. The RESOLVED calendar is what decides that, not loc.outputCalendar,
+// which is null in exactly that case. Weekdays and day periods do not depend on
+// the calendar and so never ask.
+function cfGregorian(loc) {
+  let ok = cfCalendars.get(loc);
+
+  if (ok === undefined) {
+    cfCalendars.set(loc, (ok = new Intl.DateTimeFormat(loc.intl).resolvedOptions().calendar === "gregory"));
+  }
+
+  return ok;
+}
+
+function cfOffset(format) {
+  return (f, dt) => {
+    if (dt.isOffsetFixed && dt.offset === 0 && f.opts.allowZ) {
+      return "Z";
+    }
+
+    return dt.isValid ? dt.zone.formatOffset(dt.ts, format) : "";
+  };
+}
+
+function cfMonth(length, standalone) {
+  // hoisted: the interpreter rebuilt this literal on every value
+  const opts = standalone ? { month: length } : { month: length, day: "numeric" };
+  const key = (standalone ? "L" : "M") + length;
+
+  return (f, dt, en) =>
+    en
+      ? English.monthForDateTime(dt, length)
+      : cfGregorian(f.loc)
+        ? cfMemo(f, dt, opts, "month", key, 12, dt.month - 1)
+        : cfExtract(f, dt, opts, "month");
+}
+
+function cfWeekday(length, standalone) {
+  const opts = standalone
+    ? { weekday: length }
+    : { weekday: length, month: "long", day: "numeric" };
+  const key = (standalone ? "c" : "E") + length;
+
+  return (f, dt, en) =>
+    en ? English.weekdayForDateTime(dt, length) : cfMemo(f, dt, opts, "weekday", key, 7, dt.weekday - 1);
+}
+
+function cfEra(length) {
+  const opts = { era: length };
+  const key = "G" + length;
+  // <= 0, not < 0: luxon's year 0 is the proleptic one, which every locale
+  // renders as 1 BC. Filing it under AD is only visible once two DateTimes share
+  // a Locale, which they do not until locales are interned.
+
+  return (f, dt, en) =>
+    en
+      ? English.eraForDateTime(dt, length)
+      : cfGregorian(f.loc)
+        ? cfMemo(f, dt, opts, "era", key, 2, dt.year <= 0 ? 0 : 1)
+        : cfExtract(f, dt, opts, "era");
+}
+
+const CF_DAY_NUM = { day: "numeric" };
+const CF_DAY_2D = { day: "2-digit" };
+const CF_MONTH_NUM_DAY = { month: "numeric", day: "numeric" };
+const CF_MONTH_2D_DAY = { month: "2-digit", day: "numeric" };
+const CF_MONTH_NUM = { month: "numeric" };
+const CF_MONTH_2D = { month: "2-digit" };
+const CF_YEAR_NUM = { year: "numeric" };
+const CF_YEAR_2D = { year: "2-digit" };
+const CF_DAYPERIOD = { hour: "numeric", hourCycle: "h12" };
+
+const cfHandlers = {
+  // ms
+  S: (f, dt) => f.num(dt.millisecond),
+  u: (f, dt) => f.num(dt.millisecond, 3),
+  SSS: (f, dt) => f.num(dt.millisecond, 3),
+  // seconds
+  s: (f, dt) => f.num(dt.second),
+  ss: (f, dt) => f.num(dt.second, 2),
+  // fractional seconds
+  uu: (f, dt) => f.num(Math.floor(dt.millisecond / 10), 2),
+  uuu: (f, dt) => f.num(Math.floor(dt.millisecond / 100)),
+  // minutes
+  m: (f, dt) => f.num(dt.minute),
+  mm: (f, dt) => f.num(dt.minute, 2),
+  // hours
+  h: (f, dt) => f.num(dt.hour % 12 === 0 ? 12 : dt.hour % 12),
+  hh: (f, dt) => f.num(dt.hour % 12 === 0 ? 12 : dt.hour % 12, 2),
+  H: (f, dt) => f.num(dt.hour),
+  HH: (f, dt) => f.num(dt.hour, 2),
+  // offset
+  Z: cfOffset("narrow"),
+  ZZ: cfOffset("short"),
+  ZZZ: cfOffset("techie"),
+  ZZZZ: (f, dt) => dt.zone.offsetName(dt.ts, { format: "short", locale: f.loc.locale }),
+  ZZZZZ: (f, dt) => dt.zone.offsetName(dt.ts, { format: "long", locale: f.loc.locale }),
+  // zone
+  z: (f, dt) => dt.zoneName,
+  // meridiems
+  // Keyed by hour across 24 slots rather than by hour < 12 across two. The opts
+  // name only the hour, so the hour is the whole of what the answer can depend
+  // on, and keying on it directly costs 22 array slots and assumes nothing. Two
+  // slots would instead bake in Locale#meridiems' assumption that a locale has
+  // exactly two day periods — which its own comment calls "probably wrong", and
+  // which is not this code's assumption to make.
+  a: (f, dt, en) =>
+    en ? English.meridiemForDateTime(dt) : cfMemo(f, dt, CF_DAYPERIOD, "dayperiod", "a", 24, dt.hour),
+  // dates
+  d: (f, dt, en, useDTF) => (useDTF ? cfExtract(f, dt, CF_DAY_NUM, "day") : f.num(dt.day)),
+  dd: (f, dt, en, useDTF) => (useDTF ? cfExtract(f, dt, CF_DAY_2D, "day") : f.num(dt.day, 2)),
+  // weekdays - standalone
+  c: (f, dt) => f.num(dt.weekday),
+  ccc: cfWeekday("short", true),
+  cccc: cfWeekday("long", true),
+  ccccc: cfWeekday("narrow", true),
+  // weekdays - format
+  E: (f, dt) => f.num(dt.weekday),
+  EEE: cfWeekday("short", false),
+  EEEE: cfWeekday("long", false),
+  EEEEE: cfWeekday("narrow", false),
+  // months - standalone
+  L: (f, dt, en, useDTF) =>
+    useDTF ? cfExtract(f, dt, CF_MONTH_NUM_DAY, "month") : f.num(dt.month),
+  LL: (f, dt, en, useDTF) =>
+    useDTF ? cfExtract(f, dt, CF_MONTH_2D_DAY, "month") : f.num(dt.month, 2),
+  LLL: cfMonth("short", true),
+  LLLL: cfMonth("long", true),
+  LLLLL: cfMonth("narrow", true),
+  // months - format
+  M: (f, dt, en, useDTF) => (useDTF ? cfExtract(f, dt, CF_MONTH_NUM, "month") : f.num(dt.month)),
+  MM: (f, dt, en, useDTF) =>
+    useDTF ? cfExtract(f, dt, CF_MONTH_2D, "month") : f.num(dt.month, 2),
+  MMM: cfMonth("short", false),
+  MMMM: cfMonth("long", false),
+  MMMMM: cfMonth("narrow", false),
+  // years
+  y: (f, dt, en, useDTF) => (useDTF ? cfExtract(f, dt, CF_YEAR_NUM, "year") : f.num(dt.year)),
+  yy: (f, dt, en, useDTF) =>
+    useDTF ? cfExtract(f, dt, CF_YEAR_2D, "year") : f.num(dt.year.toString().slice(-2), 2),
+  yyyy: (f, dt, en, useDTF) =>
+    useDTF ? cfExtract(f, dt, CF_YEAR_NUM, "year") : f.num(dt.year, 4),
+  yyyyyy: (f, dt, en, useDTF) =>
+    useDTF ? cfExtract(f, dt, CF_YEAR_NUM, "year") : f.num(dt.year, 6),
+  // eras
+  G: cfEra("short"),
+  GG: cfEra("long"),
+  GGGGG: cfEra("narrow"),
+  // week dates
+  kk: (f, dt) => f.num(dt.weekYear.toString().slice(-2), 2),
+  kkkk: (f, dt) => f.num(dt.weekYear, 4),
+  W: (f, dt) => f.num(dt.weekNumber),
+  WW: (f, dt) => f.num(dt.weekNumber, 2),
+  n: (f, dt) => f.num(dt.localWeekNumber),
+  nn: (f, dt) => f.num(dt.localWeekNumber, 2),
+  ii: (f, dt) => f.num(dt.localWeekYear.toString().slice(-2), 2),
+  iiii: (f, dt) => f.num(dt.localWeekYear, 4),
+  // ordinal, quarter, epoch
+  o: (f, dt) => f.num(dt.ordinal),
+  ooo: (f, dt) => f.num(dt.ordinal, 3),
+  q: (f, dt) => f.num(dt.quarter),
+  qq: (f, dt) => f.num(dt.quarter, 2),
+  X: (f, dt) => f.num(Math.floor(dt.ts / 1000)),
+  x: (f, dt) => f.num(dt.ts),
+};
+
+function cfCompile(fmt) {
+  const lits = [];
+  const fns = [];
+  let lit = "";
+
+  for (const token of Formatter.parseFormat(fmt)) {
+    if (token.literal) {
+      lit += token.val;
+      continue;
+    }
+
+    const handler = cfHandlers[token.val];
+
+    if (handler !== undefined) {
+      lits.push(lit);
+      lit = "";
+      fns.push(handler);
+      continue;
+    }
+
+    const macroOpts = Formatter.macroTokenToFormatOpts(token.val);
+
+    if (macroOpts) {
+      lits.push(lit);
+      lit = "";
+      fns.push((f, dt) => f.formatWithSystemDefault(dt, macroOpts));
+      continue;
+    }
+
+    // the interpreter's default branch returned an unrecognized token verbatim,
+    // so it is nothing but literal text
+    lit += token.val;
+  }
+
+  lits.push(lit);
+
+  return { lits, fns };
+}
+
+function cfRun(f, dt, fmt) {
+  let program = cfPrograms.get(fmt);
+
+  if (program === undefined) {
+    program = cfCompile(fmt);
+
+    if (cfPrograms.size < CF_CACHE_MAX) {
+      cfPrograms.set(fmt, program);
+    }
+  }
+
+  const { lits, fns } = program;
+  const en = f.loc.listingMode() === "en";
+  const useDTF = f.loc.outputCalendar && f.loc.outputCalendar !== "gregory";
+
+  let s = lits[0];
+
+  for (let i = 0; i < fns.length; i++) {
+    s += fns[i](f, dt, en, useDTF) + lits[i + 1];
+  }
+
+  return s;
+}
+
+const cfDurationFields = {
+  S: "milliseconds",
+  s: "seconds",
+  m: "minutes",
+  h: "hours",
+  d: "days",
+  w: "weeks",
+  M: "months",
+  y: "years",
+};
+
+function cfCompileDuration(fmt) {
+  const lits = [];
+  const fields = [];
+  const widths = [];
+  let lit = "";
+
+  for (const token of Formatter.parseFormat(fmt)) {
+    const field = token.literal ? undefined : cfDurationFields[token.val[0]];
+
+    if (field === undefined) {
+      lit += token.val;
+    } else {
+      lits.push(lit);
+      lit = "";
+      fields.push(field);
+      widths.push(token.val.length);
+    }
+  }
+
+  lits.push(lit);
+
+  return { lits, fields, widths };
+}
+
+function cfRunDuration(f, dur, fmt) {
+  let program = cfDurationPrograms.get(fmt);
+
+  if (program === undefined) {
+    program = cfCompileDuration(fmt);
+
+    if (cfDurationPrograms.size < CF_CACHE_MAX) {
+      cfDurationPrograms.set(fmt, program);
+    }
+  }
+
+  const { lits, fields, widths } = program;
+  const collapsed = dur.shiftTo(...fields);
+  const negative = collapsed < 0;
+  const largest = Object.keys(collapsed.values)[0];
+  const signMode = f.opts.signMode;
+  let s = lits[0];
+
+  for (let i = 0; i < fields.length; i++) {
+    const field = fields[i];
+    const secondaryNegative = signMode === "negativeLargestOnly" && negative && field !== largest;
+    const signDisplay =
+      signMode === "negativeLargestOnly" && field !== largest
+        ? "never"
+        : signMode === "all"
+          ? "always"
+          : "auto";
+
+    let value = collapsed.get(field) * (secondaryNegative ? -1 : 1);
+
+    // Keep upstream's negative-zero fix when the largest unit rounds to zero:
+    // "auto" otherwise drops the only sign on a negative duration.
+    if (signMode === "negativeLargestOnly" && field === largest && negative && value === 0) {
+      value = -0;
+    }
+
+    s += f.num(value, widths[i], signDisplay) + lits[i + 1];
+  }
+
+  return s;
+}
