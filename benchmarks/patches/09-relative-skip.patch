+// UPSTREAM-I: the least real time one step of each unit can span, so that two
+// instants closer together than this cannot be one of that unit apart and the
+// diff below is one whose answer is already known.
+//
+// A step of one unit keeps the wall time and advances the local calendar by at
+// least N days -- 365 for a year (Feb 29 to Feb 28), 89 for a quarter (Jan 31 to
+// Apr 30), 28 for a month, 7 for a week -- and lands on an offset at most 26
+// hours from the one it left, since IANA offsets run from -12:00 to +14:00. So
+// the step covers at least N days less 26 hours of real time. Deriving it that
+// way rather than measuring tzdata matters: the shortest week on record is six
+// days, because Pacific/Apia deleted 2011-12-30 outright, and a floor fitted to
+// the ordinary one-hour spring forward would have skipped it.
+//
+// A day is not on the list because a day less 26 hours is negative -- and it is
+// not an idle margin, Antarctica/Macquarie moved ten hours in 1948, making a
+// local day fourteen hours long.
+const relativeFloor = {
+  years: 365 * 86400000 - 26 * 3600000,
+  quarters: 89 * 86400000 - 26 * 3600000,
+  months: 28 * 86400000 - 26 * 3600000,
+  weeks: 7 * 86400000 - 26 * 3600000,
+  hours: 3600000,
+  minutes: 60000,
+  seconds: 1000,
+  milliseconds: 1,
+};
+
 function diffRelative(start, end, opts) {
   const round = isUndefined(opts.round) ? true : opts.round,
     rounding = isUndefined(opts.rounding) ? "trunc" : opts.rounding,
@@ -491,7 +518,15 @@ function diffRelative(start, end, opts) {
     return format(differ(opts.unit), opts.unit);
   }
 
+  // -1 disables the skip for the calendary path, where a unit counts boundary
+  // crossings rather than elapsed time: 23:00 and 01:00 are two hours apart and
+  // one day apart, so no spread implies anything there.
+  const spread = opts.calendary ? -1 : Math.abs(end.ts - start.ts);
+
   for (const unit of opts.units) {
+    // skipping a diff whose result is already known, not deciding it differently
+    if (spread >= 0 && spread < relativeFloor[unit]) continue;
+
     const count = differ(unit);
     if (Math.abs(count) >= 1) {
       return format(count, unit);
@@ -2295,7 +2330,9 @@ export default class DateTime {
