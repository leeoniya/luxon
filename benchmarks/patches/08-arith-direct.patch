@@ -1,9 +1,35 @@
 import Duration from "../duration.js";
+import { objToLocalTS } from "./util.js";
 
-function dayDiff(earlier, later) {
-  const utcDayStart = (dt) => dt.toUTC(0, { keepLocalTime: true }).startOf("day").valueOf(),
-    ms = utcDayStart(later) - utcDayStart(earlier);
-  return Math.floor(Duration.fromMillis(ms).as("days"));
+// UPSTREAM-H: was dt.toUTC(0, { keepLocalTime: true }).startOf("day").valueOf(),
+// inline in dayDiff. Both steps clone, and both clones reconstruct, so reading
+// one number cost four DateTimes. What the expression asks for is the UTC
+// midnight of the civil date, and the civil date is what dt.c already holds:
+// keepLocalTime carries c across unchanged, UTC's offset is 0 so objToTS is
+// objToLocalTS, and startOf("day") only zeroes the time fields. objToLocalTS and
+// not Date.UTC because years 0-99 need the fixup it does.
+const utcDayStart = (dt) =>
+  objToLocalTS({
+    year: dt.c.year,
+    month: dt.c.month,
+    day: dt.c.day,
+    hour: 0,
+    minute: 0,
+    second: 0,
+    millisecond: 0,
+  });
+
+function dayDiff(earlier, later) {
+  const ms = utcDayStart(later) - utcDayStart(earlier);
+  // UPSTREAM-H: was Math.floor(Duration.fromMillis(ms).as("days")) — a Duration
+  // built and converted to reach one division, since shiftTo puts a lone
+  // milliseconds value into days through its leftover loop. Both endpoints are
+  // UTC midnights, so the difference is a whole number of days. The finite guard
+  // keeps the old path for the input that would throw out of Duration.fromMillis
+  // rather than divide.
+  return Number.isFinite(ms)
+    ? Math.floor(ms / 86400000)
+    : Math.floor(Duration.fromMillis(ms).as("days"));
 }
 
