+// UPSTREAM-E: one transition-free interval cache, shared by the two Intl
+// lookups that want one -- IANAZone#offset over in zones/IANAZone.js, and
+// parseZoneInfo below.
+//
+// An offset or a name only changes at a transition, so a value inside a span
+// that two agreeing probes prove transition-free needs no Intl call at all. The
+// span is exact rather than a guess: probes sit 2 days apart, and the shortest
+// window in which any zone's offset or CLDR name departs and returns is 6.96
+// days, so departing and returning unseen between one probe and the next cannot
+// happen.
+const INTERVAL_PROBE_MS = 2 * 86400000;
+const INTERVAL_MAX_REACH = 256;
+const INTERVAL_MAX_TS = 8.64e15;
+
+export function newInterval() {
+  return { lo: 1, hi: 0, val: null, reach: 0, hits: 0, misses: 0 };
+}
+
+/**
+ * What lookup(ctx, t) returns at t, reused across the transition-free interval
+ * around t. The caller owns the state, so where it is cached -- per zone, per
+ * scanner -- is the caller's business and its reset is too.
+ */
+export function intervalLookup(st, lookup, ctx, t) {
+  if (t >= st.lo && t <= st.hi) {
+    st.hits++;
+    return st.val;
+  }
+
+  const val = lookup(ctx, t);
+  const forward = t > st.hi;
+
+  st.val = val;
+  st.lo = t;
+  st.hi = t;
+
+  for (let k = 1; k <= st.reach; k++) {
+    const p = t + (forward ? k : -k) * INTERVAL_PROBE_MS;
+    if (!(Math.abs(p) <= INTERVAL_MAX_TS) || lookup(ctx, p) !== val) break;
+    if (forward) st.hi = p;
+    else st.lo = p;
+  }
+
+  st.misses++;
+  // probe budget = what the last interval paid back; a miss streak (random
+  // access) decays it to zero, with an occasional single probe to notice if the
+  // caller has started walking in order after all
+  st.reach = st.hits > 0 ? Math.min(st.hits, INTERVAL_MAX_REACH) : (st.misses & 15) === 0 ? 1 : 0;
+  st.hits = 0;
+
+  return val;
+}
