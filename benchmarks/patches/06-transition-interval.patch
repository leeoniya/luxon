+// UPSTREAM-F: one transition-free interval cache, shared by the two Intl
+// lookups that want one -- IANAZone#offset over in zones/IANAZone.js, and
+// parseZoneInfo below.
+//
+// An offset or a name only changes at a transition, so a value inside a span
+// that two agreeing probes prove transition-free needs no Intl call at all. The
+// span is exact rather than a guess: probes sit 2 days apart, and the shortest
+// window in which any zone's offset or CLDR name departs and returns is 6.96
+// days, so departing and returning unseen between one probe and the next cannot
+// happen.
+const INTERVAL_PROBE_MS = 2 * 86400000;
+const INTERVAL_MAX_REACH = 256;
+const INTERVAL_MAX_TS = 8.64e15;
+
+// Two spans, most-recently-used first. One is not enough, and the reason is the
+// caller rather than the data: placing a local time asks the zone about three
+// instants -- fixOffset seeds itself with the offset at Settings.now(), then
+// probes twice around the target -- so a single span is evicted by the next
+// lookup in the same parse, every parse. Two is the structural minimum, one for
+// the seed and one for the target, whose probes sit about an hour apart and so
+// share a span unless a transition falls between them. A third for that case
+// measured as nothing on any realistic range and is not worth its branches.
+export function newInterval() {
+  return {
+    lo0: 1, hi0: 0, val0: null,
+    lo1: 1, hi1: 0, val1: null,
+    reach: 0, hits: 0,
+  };
+}
+
+/**
+ * What lookup(ctx, t) returns at t, reused across the transition-free interval
+ * around t. The caller owns the state, so where it is cached -- per zone, per
+ * scanner -- is the caller's business and its reset is too.
+ */
+export function intervalLookup(st, lookup, ctx, t) {
+  if (t >= st.lo0 && t <= st.hi0) {
+    st.hits++;
+    return st.val0;
+  }
+
+  // a hit in the colder span swaps it to the front, so the one a miss evicts is
+  // always the less recently used
+  if (t >= st.lo1 && t <= st.hi1) {
+    st.hits++;
+    const lo = st.lo0, hi = st.hi0, v = st.val0;
+    st.lo0 = st.lo1; st.hi0 = st.hi1; st.val0 = st.val1;
+    st.lo1 = lo; st.hi1 = hi; st.val1 = v;
+    return st.val0;
+  }
+
+  const val = lookup(ctx, t);
+
+  st.lo1 = st.lo0; st.hi1 = st.hi0; st.val1 = st.val0;
+  st.val0 = val;
+  st.lo0 = t;
+  st.hi0 = t;
+
+  // Anchor the span AROUND t, both directions, rather than in the direction the
+  // last miss travelled: with several call sites interleaved that direction
+  // belongs to another site, and a reader sweeping forward would keep extending
+  // backward over ground it has already left. One probe each way is the floor,
+  // because a span that reaches nothing can never be hit, and a budget that only
+  // grows after a hit can then never grow.
+  //
+  // reach is the budget for the pair, so widening costs what it always did; only
+  // the floor is new.
+  const side = (st.reach >> 1) + 1;
+
+  for (let k = 1; k <= side; k++) {
+    const p = t + k * INTERVAL_PROBE_MS;
+    if (!(Math.abs(p) <= INTERVAL_MAX_TS) || lookup(ctx, p) !== val) break;
+    st.hi0 = p;
+  }
+
+  for (let k = 1; k <= side; k++) {
+    const p = t - k * INTERVAL_PROBE_MS;
+    if (!(Math.abs(p) <= INTERVAL_MAX_TS) || lookup(ctx, p) !== val) break;
+    st.lo0 = p;
+  }
+
+  // probe budget = what the last span paid back, so a sequential reader widens
+  // toward MAX_REACH while a scattered one stays near the floor
+  st.reach = Math.min(st.hits, INTERVAL_MAX_REACH);
+  st.hits = 0;
+
+  return val;
+}
+
 // Either side of a DST boundary, and one that renders a one-digit hour if the
 // locale does not honor 2-digit: a surround that is not fixed-width shows up as
 // a disagreement here rather than as a wrong name later.
@@ -300,7 +389,7 @@ function makeNameScanner(locale, offsetFormat, timeZone) {
     }
   }
 
-  return { dtf, pre, suf };
+  return { dtf, pre, suf, iv: newInterval() };
 }
 
 function zoneNameScanner(locale, offsetFormat, timeZone) {
@@ -324,7 +413,7 @@ export function parseZoneInfo(ts, offsetFormat, locale, timeZone = null) {
   const scan = zoneNameScanner(locale, offsetFormat, timeZone);
 
   if (scan !== null) {
-    return scanName(scan, ts);
+    return intervalLookup(scan.iv, scanName, scan, ts);
   }
 
   const date = new Date(ts),
