@@ -283,7 +324,7 @@ export default class IANAZone extends Zone {
     if (scan !== null) {
       const t = Math.trunc(ts);
       if (!(Math.abs(t) <= 8.64e15)) return NaN;
-      return scan(t);
+      return intervalOffset(this.name, scan, t);
     }
 
