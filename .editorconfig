root = true

[*]
charset = utf-8
indent_size = 2
end_of_line = lf
indent_style = space
insert_final_newline = false
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# An empty context line in a unified diff is a single space. Trimming it would
# silently corrupt the patches in benchmarks/patches.
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = true
